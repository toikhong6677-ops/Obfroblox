local RemoteDecoder = {}

local SECRET_KEY = "20@bnhkobt"
local ALPHABET = "QMabcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$"

local function GetXorModifier(index)
    local key_len = #SECRET_KEY
    local char_1 = string.byte(SECRET_KEY, ((index - 1) % key_len) + 1)
    local char_2 = string.byte(ALPHABET, (index % #ALPHABET) + 1)
    return (char_1 + char_2) % 256
end

function RemoteDecoder:DecryptAndExecute(encrypted_str)
    local tokens = {}
    for num in string.gmatch(encrypted_str, "[^-]+") do
        table.insert(tokens, tonumber(num))
    end
    
    local decrypted_bytes = {}
    local total_tokens = #tokens
    
    for i = 1, total_tokens, 2 do
        local pair_index = math.floor((i - 1) / 2) + 1
        local xor_key = GetXorModifier(pair_index)
        
        local dec1 = bit32.bxor(tokens[i], xor_key)
        table.insert(decrypted_bytes, string.char(dec1))
        
        if i + 1 <= total_tokens then
            local dec2 = bit32.bxor(tokens[i + 1], xor_key)
            table.insert(decrypted_bytes, string.char(dec2))
        end
    end
    
    local raw_bytecode = table.concat(decrypted_bytes)
    local func, err = loadstring(raw_bytecode)
    raw_bytecode = nil
    collectgarbage("collect")
    
    if func then
        return func
    else
        error("Bẻ khóa thất bại hoặc Bytecode không hợp lệ: " .. tostring(err))
    end
end

return RemoteDecoder
