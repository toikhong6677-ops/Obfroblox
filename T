local function VerifyEnvironment()
    local targets = {loadstring, string.byte, bit32.bxor, string.char}
    for _, func in ipairs(targets) do
        local info = debug.getinfo(func)
        -- Trong Luau/Roblox, các hàm hệ thống gốc phải là hàm C thuần ("=[C]")
        if info.what ~= "C" or info.source ~= "=[C]" then
